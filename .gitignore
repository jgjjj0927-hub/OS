import re

def parse_slug(slug: str) -> str:
    """Превращает 'MoodPack-23482' в 'Mood Pack #23482'. Поддерживает любое имя."""
    match = re.match(r"^(.*?)[-_]?(\d+)$", slug)
    if match:
        name_part, number = match.group(1), match.group(2)
    else:
        name_part, number = slug, None

    spaced = re.sub(r"([a-z])([A-Z])", r"\1 \2", name_part)
    spaced = re.sub(r"[-_]+", " ", spaced).strip()

    if number:
        return f"{spaced} #{number}"
    return spaced





