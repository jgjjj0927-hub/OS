import re

def parse_slug(slug: str) -> str:
    """Превращает 'MoodPack-23482' в 'Mood Pack #23482'."""
    parts = re.split(r"[-_]", slug)
    out = []
    for p in parts:
        if p.isdigit():
            out.append(f"#{p}")
        elif p:
            # вставляем пробел перед заглавными, если это camelCase
            spaced = re.sub(r"([a-z])([A-Z])", r"\1 \2", p)
            out.append(spaced)
    return " ".join(out).strip()
































































